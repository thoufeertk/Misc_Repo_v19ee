<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_property_inherit" model="ir.ui.view">
        <field name="name">account.move.form.property.management</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="property_tenancy_id" readonly="1" invisible="not property_tenancy_id"/>
                <field name="property_building_id" readonly="1" invisible="not property_building_id"/>
            </xpath>
        </field>
    </record>

</odoo>
