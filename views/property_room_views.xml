<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_property_room_list" model="ir.ui.view">
        <field name="name">property.room.list</field>
        <field name="model">property.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="name"/>
                <field name="building_id"/>
                <field name="floor"/>
                <field name="room_type"/>
                <field name="furnishing_status"/>
                <field name="area"/>
                <field name="rent_amount"/>
                <field name="tenant_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'vacant'"
                       decoration-danger="status == 'occupied'"
                       decoration-warning="status == 'maintenance'"/>
            </list>
        </field>
    </record>

    <record id="view_property_room_kanban" model="ir.ui.view">
        <field name="name">property.room.kanban</field>
        <field name="model">property.room</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="image_128" widget="image" class="o_kanban_image me-3 rounded"
                                   options="{'size': [64, 64]}" alt="Room"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong> - <field name="building_id"/>
                                <div class="text-muted">
                                    <field name="room_type"/> · <field name="area"/> sqft
                                </div>
                                <span class="badge rounded-pill"
                                      t-attf-class="text-bg-{{record.status.raw_value == 'vacant' and 'success' or (record.status.raw_value == 'occupied' and 'danger' or 'warning')}}">
                                    <field name="status"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_property_room_form" model="ir.ui.view">
        <field name="name">property.room.form</field>
        <field name="model">property.room</field>
        <field name="arch" type="xml">
            <form string="Room / Unit">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tenancies" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="tenancy_ids" widget="statinfo" string="Tenancies"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Under Maintenance" bg_color="text-bg-warning"
                            invisible="not under_maintenance"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Room / Unit No."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="building_id"/>
                            <field name="floor"/>
                            <field name="room_type"/>
                            <field name="furnishing_status"/>
                            <field name="area"/>
                            <field name="bathroom_count"/>
                            <field name="balcony_count"/>
                        </group>
                        <group string="Status &amp; Rent">
                            <field name="currency_id" invisible="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'vacant'"
                                   decoration-danger="status == 'occupied'"
                                   decoration-warning="status == 'maintenance'"/>
                            <field name="tenant_id"/>
                            <field name="under_maintenance"/>
                            <field name="rent_amount"/>
                            <field name="security_deposit"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="amenity_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                               colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Gallery" name="gallery">
                            <field name="room_image_ids">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div class="o_kanban_image_wrapper">
                                                <field name="image_256" widget="image" class="o_kanban_image"
                                                       options="{'size': [256, 256]}" alt="Room photo"/>
                                                <field name="name" placeholder="Caption"/>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Tenancy History" name="tenancies">
                            <field name="tenancy_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="rent_amount"/>
                                    <field name="invoice_frequency"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_property_room_search" model="ir.ui.view">
        <field name="name">property.room.search</field>
        <field name="model">property.room</field>
        <field name="arch" type="xml">
            <search string="Rooms">
                <field name="name"/>
                <field name="building_id"/>
                <field name="tenant_id"/>
                <field name="amenity_ids"/>
                <filter string="Vacant" name="filter_vacant" domain="[('status', '=', 'vacant')]"/>
                <filter string="Occupied" name="filter_occupied" domain="[('status', '=', 'occupied')]"/>
                <filter string="Under Maintenance" name="filter_maintenance" domain="[('status', '=', 'maintenance')]"/>
                <group>
                    <filter string="Building" name="groupby_building" context="{'group_by': 'building_id'}"/>
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                    <filter string="Type" name="groupby_type" context="{'group_by': 'room_type'}"/>
                    <filter string="Furnishing" name="groupby_furnishing" context="{'group_by': 'furnishing_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_property_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">property.room</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_property_room_search"/>
        <field name="context">{'search_default_groupby_building': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first room / unit
            </p>
        </field>
    </record>

</odoo>
