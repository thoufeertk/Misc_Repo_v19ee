<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.property.management</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Property Management" string="Property Management"
                     name="msr_property_management" id="msr_property_management_settings">
                    <block title="Rent Invoicing" id="property_invoicing_setting_container">
                        <setting id="property_default_journal_setting"
                                 help="Used for rent invoices when a tenancy does not specify its own sales journal.">
                            <field name="property_default_journal_id"/>
                        </setting>
                        <setting id="property_default_product_setting"
                                 help="Proposed by default as the invoicing product on new tenancies.">
                            <field name="property_default_product_id"/>
                        </setting>
                        <setting id="property_auto_post_setting"
                                 help="Automatically post rent invoices generated by the recurring invoicing cron, instead of leaving them in draft for manual review.">
                            <field name="property_auto_post_invoices"/>
                        </setting>
                    </block>
                    <block title="Reminders" id="property_reminder_setting_container">
                        <setting id="property_document_reminder_setting"
                                 help="Default number of days before expiry to warn about a building document.">
                            <div class="content-group">
                                <field name="property_document_reminder_days" class="o_light_label"
                                       style="width: 4rem;"/>
                                <span> days</span>
                            </div>
                        </setting>
                        <setting id="property_tenancy_reminder_setting"
                                 help="Number of days before a tenancy's end date to remind the property manager.">
                            <div class="content-group">
                                <field name="property_tenancy_reminder_days" class="o_light_label"
                                       style="width: 4rem;"/>
                                <span> days</span>
                            </div>
                        </setting>
                    </block>
                    <block title="Sample Data" id="property_demo_setting_container">
                        <setting id="property_demo_data_setting"
                                 help="Populate this database with sample buildings, rooms, tenants, tenancies and documents so you can explore the app.">
                            <div class="content-group">
                                <button name="action_load_property_demo_data" type="object"
                                        string="Load Demo Data" class="btn-primary"
                                        invisible="demo_data_loaded"/>
                                <span class="text-success" invisible="not demo_data_loaded">
                                    Demo data is loaded. Click again to refresh it.
                                </span>
                                <button name="action_load_property_demo_data" type="object"
                                        string="Reload Demo Data" class="btn-secondary"
                                        invisible="not demo_data_loaded"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_property_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'msr_property_management', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_property_configuration" name="Configuration"
              parent="menu_msr_property_management_root" sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_property_config_settings" name="Settings"
              parent="menu_property_configuration" action="action_property_config_settings"
              sequence="10" groups="base.group_system"/>

    <menuitem id="menu_property_amenity" name="Amenities"
              parent="menu_property_configuration" action="action_property_amenity"
              sequence="20" groups="base.group_system"/>
</odoo>
